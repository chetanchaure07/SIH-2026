# ============================================================
# SIH-2026 Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/sih_energy

# Express server port (default: 3001)
PORT=3001

# Frontend URL (for CORS — default is Vite dev server)
FRONTEND_URL=http://localhost:5173
